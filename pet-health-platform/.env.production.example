# Copy to .env.production ON THE SERVER and fill it there. Never commit secrets.
# Use the approved, already-migrated PostgreSQL database. Do not use a file: URL.
DATABASE_URL="postgresql://USER:PASSWORD@DATABASE_HOST:5432/DATABASE?sslmode=require"
AI_API_KEY=
AI_API_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash

# Optional: change the public HTTP port or bind only to a reverse proxy.
APP_PORT=3000
APP_BIND_ADDRESS=0.0.0.0
