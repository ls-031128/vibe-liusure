# Neon PostgreSQL pooled connection URL used by the application at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST:5432/DATABASE?sslmode=require"

# Direct PostgreSQL connection URL used by Prisma CLI migrations.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?sslmode=require"

# Optional: use a dedicated non-production database/branch for API integration tests.
# Do not set this to the production DATABASE_URL.
TEST_DATABASE_URL=""

# Non-secret identifiers. Fill these only after manually matching the endpoint
# to the test branch in Neon Console. The scripts check URL/ID consistency but
# cannot verify branch ownership with Neon itself.
# NEON_TEST_BRANCH_ID=
# NEON_TEST_ENDPOINT_ID=

# Day 7: server-side DeepSeek API base URL and model.
AI_API_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
# Fill this locally or in the hosting platform's server environment.
# Never add a real key here or use a NEXT_PUBLIC_ variable for it.
AI_API_KEY=
