{
  "name": "pet-health-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:generate && next build",
    "build:safe": "node scripts/run-safe-build.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs unit",
    "test:db": "node scripts/run-tests.mjs database",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:validate": "prisma validate --config prisma7.config.ts",
    "db:migrate:dev": "node scripts/run-safe-migration.mjs dev",
    "db:migrate:deploy": "node scripts/run-safe-migration.mjs deploy"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "16.6.1",
    "next": "latest",
    "pg": "8.23.1",
    "react": "latest",
    "react-dom": "latest",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pg": "8.23.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "prisma": "7.10.0",
    "typescript": "latest"
  }
}
